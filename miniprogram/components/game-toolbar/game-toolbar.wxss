.game-toolbar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.tool-button {
  min-height: 64rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #edf3f2;
  color: #1f2933;
  font-size: 24rpx;
}

.tool-button.is-active {
  background: #1f6f78;
  color: #ffffff;
}

.tool-button::after {
  border: 0;
}
