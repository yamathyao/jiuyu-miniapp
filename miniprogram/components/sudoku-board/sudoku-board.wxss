.sudoku-board {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  overflow: hidden;
  border: 3rpx solid #1f2933;
  background: #1f2933;
  aspect-ratio: 1;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 1rpx;
  background: #ffffff;
  color: #1f2933;
  font-size: 34rpx;
}

.is-given {
  background: #edf3f2;
  font-weight: 700;
}

