.number-pad {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  gap: 8rpx;
}

.number-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #ffffff;
  color: #1f6f78;
  font-size: 32rpx;
  font-weight: 650;
}

.number-button::after {
  border: 0;
}

