.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #607078;
  font-size: 26rpx;
}

.settings-link {
  color: #1f6f78;
  font-size: 28rpx;
}

.daily-panel {
  margin-top: 64rpx;
  padding: 32rpx;
  border: 1rpx solid #d9e0df;
  border-radius: 16rpx;
  background: #ffffff;
}

.panel-label {
  color: #1f6f78;
  font-size: 24rpx;
  font-weight: 600;
}

.panel-title {
  display: block;
  margin: 16rpx 0 32rpx;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.35;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

