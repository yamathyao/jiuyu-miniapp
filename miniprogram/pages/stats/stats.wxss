.page-title {
  display: block;
  margin-bottom: 28rpx;
  font-size: 40rpx;
  font-weight: 650;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-card {
  padding: 28rpx;
  border: 1rpx solid #d9e0df;
  border-radius: 12rpx;
  background: #ffffff;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #607078;
  font-size: 24rpx;
}

