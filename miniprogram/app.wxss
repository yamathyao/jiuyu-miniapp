page {
  min-height: 100vh;
  background: #f7f4ef;
  color: #1f2933;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 12rpx;
  background: #1f6f78;
  color: #ffffff;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border: 1rpx solid #c8d3d6;
  border-radius: 12rpx;
  color: #1f2933;
}

